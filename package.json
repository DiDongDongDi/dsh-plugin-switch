{
    "name": "dsh-plugin-switch",
    "version": "0.2.2",
    "description": "DSH Web settings tab to enable/disable loader plugins via profile cordis.patch.yml overlays (preserves existing config; blocks disabling ui-sidebar-right).",
    "keywords": [
        "deepseek-harness",
        "dsh",
        "dsh-plugin",
        "cordis",
        "settings",
        "plugin-toggle"
    ],
    "license": "MIT",
    "type": "module",
    "main": "index.js",
    "scripts": {
        "test": "node --test upsertDisabledOverlay.test.js"
    },
    "exports": {
        ".": "./index.js",
        "./client": "./client.js",
        "./package.json": "./package.json"
    },
    "files": [
        "index.js",
        "client.js",
        "cordis.patch.yml",
        "README.zh.md",
        "LICENSE"
    ],
    "dsh": {
        "bundle": {
            "patch": "./cordis.patch.yml"
        },
        "client": {
            "platform": "web"
        }
    },
    "engines": {
        "node": ">=22"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/DiDongDongDi/dsh-plugin-switch.git"
    }
}
